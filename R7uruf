    local sprayAntiKickEnabled, sprayAntiKickThread = false, nil
    local function toggleSprayCanAntiKick(on)
        if sprayAntiKickThread then task.cancel(sprayAntiKickThread) sprayAntiKickThread = nil end
        sprayAntiKickEnabled = on
        if not on then return end

        sprayAntiKickThread = task.spawn(function()
            while sprayAntiKickEnabled do
                local target = selectedTargetPlayer
                if not GKLib.IsTargetValid(target) then
                    task.wait(0.5)
                else
                    local can = GKLib.getToy("SprayCanWD") or GKLib.getToy("SprayCan") or GKLib.spawnToy("SprayCanWD")
                    local canPart = can and (can:IsA("BasePart") and can or can:FindFirstChild("Handle") or can:FindFirstChildWhichIsA("BasePart") or can.PrimaryPart)
                    if canPart then
                        GKLib.SetNetworkOwner(canPart)
                        local pitchSpeed, pitchAngleRange = 10, math.rad(40)
                        while sprayAntiKickEnabled and GKLib.IsTargetValid(selectedTargetPlayer) and selectedTargetPlayer == target and can and can.Parent do
                            local tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                            if not tRoot then break end

                            local backPos = tRoot.Position - (tRoot.CFrame.LookVector * 2.5) + Vector3.new(0, 0.5, 0)
                            local baseCF = CFrame.lookAt(backPos, tRoot.Position)
                            local pitch = math.sin(tick() * pitchSpeed) * pitchAngleRange
                            
                            GKLib.ApplyCFrame(canPart, baseCF * CFrame.Angles(pitch, 0, 0))
                            GKLib.SetNetworkOwner(canPart)
                            RunService.Heartbeat:Wait()
                        end
                    else
                        task.wait(0.2)
                    end
                end
            end
        end)
    end

