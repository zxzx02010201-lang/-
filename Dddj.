                if hum and root and hum.Health > 0 then
                    if hum.Sit and hum.SeatPart and hum.SeatPart.Parent and hum.SeatPart.Parent.Name == "CreatureBlobman" then
                        hum.Sit = false
                        root.CFrame = root.CFrame + Vector3.new(0, 3, 0)
                    end
                end
            end)
        end
    end
})

