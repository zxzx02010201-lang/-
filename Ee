-- 1. Anti Toy (道具防禦系統整合)
---------------------------------------------------------
do
    local AntiToyConfig = {
        ["ToolPickaxe"] = {
            Display = "十字鎬",
            AttachTo = "Torso",
            Offset = CFrame.new(-0.02, 0.97, 0.67) * CFrame.Angles(math.rad(-88.5), math.rad(-0.4), math.rad(-0.4)),
            Rename = nil,
        },
        ["ToolPencil"] = {
            Display = "鉛筆",
            AttachTo = "Torso",
            Offset = CFrame.new(0, -1, 0) * CFrame.Angles(0, math.pi, 0),
            Rename = nil,
        },
        ["NinjaShuriken"] = {
            Display = "手裡劍",
            AttachTo = "FirePlayerPart",
            Offset = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(90), math.rad(90)),
            Rename = "AntiKick",
        },
    }
    local DisplayToName = {}
    local DropdownValues = {}
    for name, cfg in pairs(AntiToyConfig) do
        DisplayToName[cfg.Display] = name
        table.insert(DropdownValues, cfg.Display)
    end
    table.sort(DropdownValues)

    local IsActive = false
    local LoopTask = nil

    local MenuToys = ReplicatedStorage:FindFirstChild("MenuToys")
    local SpawnRemote = MenuToys and MenuToys:FindFirstChild("SpawnToyRemoteFunction")
    local DestroyToy = MenuToys and MenuToys:FindFirstChild("DestroyToy")
    local GrabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
    local SetNetworkOwner = GrabEvents and GrabEvents:FindFirstChild("SetNetworkOwner")
    local PlayerEvents = ReplicatedStorage:FindFirstChild("PlayerEvents")
    local StickyPartEvent = PlayerEvents and PlayerEvents:FindFirstChild("StickyPartEvent")

    local function ClearToys()
        task.spawn(function()
            for _ = 1, 5 do
                for name, _ in pairs(AntiToyConfig) do
                    DefenseModule.ClearToyByName(name)
                end
                task.wait(0.05)
            end
        end)
    end

    local function GetAttachPart(char)
        local cfg = AntiToyConfig[Config.SelectedToy]
        if not cfg then return nil end
        if cfg.AttachTo == "FirePlayerPart" then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end
            return hrp:FindFirstChild("FirePlayerPart") or hrp:WaitForChild("FirePlayerPart", 3)
        end
        return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    end

    local function SpawnToy()
        local toyName = Config.SelectedToy
        local cfg = AntiToyConfig[toyName]
        local _, hrp = DefenseModule.GetCharacterAndRoot()
        if not toyName or not cfg or not SpawnRemote or not hrp then return nil end
        
        local canSpawn = LocalPlayer:FindFirstChild("CanSpawnToy")
        local w = 0
        while canSpawn and not canSpawn.Value and w < 30 do task.wait(0.1); w = w + 1 end
        local inv = DefenseModule.GetToysFolder()
        if not inv then return nil end
        
        local spawned = nil
        local conn = inv.ChildAdded:Connect(function(c)
            if c.Name == toyName then spawned = c end
        end)
        
        task.spawn(function()
            pcall(function() SpawnRemote:InvokeServer(toyName, hrp.CFrame * CFrame.new(0, 2, 3), Vector3.zero) end)
        end)
        
        local t0 = tick()
        repeat task.wait(0.05) until spawned or (tick() - t0) > 1.5
        if conn then pcall(function() conn:Disconnect() end) end
        return spawned or inv:FindFirstChild(toyName)
    end

    local function StickToy(toy)
        if not toy or not toy:FindFirstChild("StickyPart") then return false end
        local cfg = AntiToyConfig[Config.SelectedToy]
        local char, _ = DefenseModule.GetCharacterAndRoot()
        if not cfg or not char then return false end
        
        local attachPart = GetAttachPart(char)
        if not attachPart then return false end
        
        local sticky = toy:FindFirstChild("StickyPart")
        local soundPart = toy:FindFirstChild("SoundPart")
        if soundPart and SetNetworkOwner then
            if not soundPart:FindFirstChild("PartOwner") or soundPart.PartOwner.Value ~= LocalPlayer.Name then
                pcall(function() SetNetworkOwner:FireServer(soundPart, soundPart.CFrame) end)
            end
        end
        if StickyPartEvent then
            pcall(function() StickyPartEvent:FireServer(sticky, attachPart, cfg.Offset) end)
        end
        for _, obj in pairs(toy:GetChildren()) do
            if obj:IsA("BasePart") then
                obj.CanTouch = false; obj.CanCollide = false; obj.CanQuery = false
            end
        end
        if cfg.Rename then toy.Name = cfg.Rename end
        return true
    end

    local function FindCurrent()
        local inv = DefenseModule.GetToysFolder()
        if not inv then return nil end
        local cfg = AntiToyConfig[Config.SelectedToy]
        local toy = inv:FindFirstChild(Config.SelectedToy)
        if not toy and cfg and cfg.Rename then toy = inv:FindFirstChild(cfg.Rename) end
        return toy or inv:FindFirstChild("AntiKick")
    end

    DropdownObjects["SelectedToy"] = aa57_defense:AddDropdown({
        Name = "防禦道具選擇",
        Default = 1,
        Values = DropdownValues,
        Callback = function(v)
            local name = DisplayToName[v]
            if name then
                local wasOn = IsActive
                if wasOn then IsActive = false; ClearToys() end
                Config.SelectedToy = name
                if wasOn then IsActive = true; task.spawn(function()
                    while IsActive do
                        task.wait(0.15)
                        local _, hrp, hum = DefenseModule.GetCharacterAndRoot()
                        if hum and hum.Health > 0 then
                            local toy = FindCurrent()
                            if not toy then
                                toy = SpawnToy()
                                if toy then task.wait(0.1); StickToy(toy) end
                            end
                        end
                    end
                end) end
            end
        end,
    })

    ToggleObjects["AntiToyOn"] = aa57_defense:AddToggle({
        Name = "啟用道具防禦 (Anti Toy)",
        Default = false,
        Callback = function(on)
            Config.AntiToyOn = on
            IsActive = on
            if on then
                LoopTask = task.spawn(function()
                    while IsActive do
                        task.wait(0.15)
                        local _, hrp, hum = DefenseModule.GetCharacterAndRoot()
                        if hum and hum.Health > 0 then
                            local toy = FindCurrent()
                            if not toy then
                                toy = SpawnToy()
                                if toy then task.wait(0.1); StickToy(toy) end
                            else
                                local sticky = toy:FindFirstChild("StickyPart")
                                if sticky and hrp and (hrp.Position - sticky.Position).Magnitude >= 25 then
                                    pcall(function() if DestroyToy then DestroyToy:FireServer(toy) end end)
                                end
                            end
                        end
                    end
                    ClearToys()
                end)
            else
                if LoopTask then pcall(function() task.cancel(LoopTask) end); LoopTask = nil end
                ClearToys()
            end
        end,
    })
end

