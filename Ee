-- 共用封包模組 (Common Defense Module)
-- 將重複使用的通用功能與防護邏輯集中管理
---------------------------------------------------------
local DefenseModule = {}

-- 安全尋找子物件
function DefenseModule.FindChildSafe(parent, name, timeout)
    if not parent then return nil end
    return parent:WaitForChild(name, timeout or 5)
end

-- 停止物件動能
function DefenseModule.StopPartMotion(part)
    if part and part:IsA("BasePart") then
        part.AssemblyLinearVelocity = Vector3.zero
        part.AssemblyAngularVelocity = Vector3.zero
        pcall(function() part.Velocity = Vector3.zero end)
        pcall(function() part.RotVelocity = Vector3.zero end)
    end
end

-- 取得玩家角色與根部位
function DefenseModule.GetCharacterAndRoot()
    local char = LocalPlayer.Character
    if not char then return nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    return char, root, hum
end

-- 取得玩家專屬生成玩具資料夾
function DefenseModule.GetToysFolder()
    return Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
end

-- 清除指定玩具
function DefenseModule.ClearToyByName(toyName)
    local inv = DefenseModule.GetToysFolder()
    local menuToys = ReplicatedStorage:FindFirstChild("MenuToys")
    local destroyRemote = menuToys and menuToys:FindFirstChild("DestroyToy")
    if inv and destroyRemote then
        for _, v in pairs(inv:GetChildren()) do
            if v.Name == toyName or v.Name == "AntiKick" or v.Name == "Noclipped" then
                pcall(function() destroyRemote:FireServer(v) end)
            end
        end
    end
end

-- 網路擁有權控制
function DefenseModule.TakeNetworkControl(part)
    if not part then return end
    local grabEvents = ReplicatedStorage:FindFirstChild("GrabEvents")
    local _, root = DefenseModule.GetCharacterAndRoot()
    if grabEvents and grabEvents:FindFirstChild("SetNetworkOwner") and root then
        pcall(function() grabEvents.SetNetworkOwner:FireServer(part, root.CFrame) end)
    end
end

-- 通用系統通知封裝
