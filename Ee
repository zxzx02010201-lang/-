---------------------------------------------------------
local function SaveData()
    local dataToSave = {}
    for key, _ in pairs(Config) do
        if type(Config[key]) ~= "table" and type(Config[key]) ~= "function" then
            dataToSave[key] = Config[key]
        end
    end

    pcall(function()
        if writefile then
            writefile(fileName, HttpService:JSONEncode(dataToSave))
            notify("配置管理", "數據已成功保存！", 2)
        end
    end)
end

local function LoadData()
    pcall(function()
        if readfile and isfile and isfile(fileName) then
            local decoded = HttpService:JSONDecode(readfile(fileName))
            if decoded then
                for key, value in pairs(decoded) do
                    Config[key] = value
                    if ToggleObjects[key] then
                        ToggleObjects[key]:Set(value)
                    elseif TextboxObjects[key] then
                        TextboxObjects[key]:Set(value)
                    elseif DropdownObjects[key] then
                        DropdownObjects[key]:Set(value)
                    end
                end
                notify("配置管理", "數據載入成功並已套用！", 2)
            end
        end
    end)
end

