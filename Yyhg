    local blob = SpawnItem("CreatureBlobman", root.CFrame * CFrame.new(0, 0, -5), Vector3.new(0, -15.716, 0))
    if not blob then return end
    local bhead = DefenseModule.FindChildSafe(blob, "Head")
    local hitbox = DefenseModule.FindChildSafe(blob, "GrabbableHitbox")
    local seat = DefenseModule.FindChildSafe(blob, "VehicleSeat")
    local ragdollRemote = ReplicatedStorage:FindFirstChild("CharacterEvents") and ReplicatedStorage.CharacterEvents:FindFirstChild("RagdollRemote")

