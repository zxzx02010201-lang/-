    textLabel.TextStrokeColor3 = Color3.fromRGB(80, 0, 0)
    textLabel.TextStrokeTransparency = 0
    textLabel.Parent = billboard

    local espConn
    espConn = RunService.RenderStepped:Connect(function()
        if not kunai or not kunai.Parent or not hl or not hl.Parent then
            if espConn then espConn:Disconnect() end
            return
        end
        local pulse = (math.sin(tick() * 7) + 1) / 2
        local redOutline = 160 + (95 * pulse)
        local greenValue = 25 * pulse

        hl.OutlineColor = Color3.fromRGB(redOutline, greenValue, greenValue)
        hl.FillColor = Color3.fromRGB(255 * pulse, 0, 0)

        if textLabel and textLabel.Parent then
            textLabel.TextColor3 = Color3.fromRGB(255, 30 + (80 * pulse), 30)
            textLabel.TextStrokeColor3 = Color3.fromRGB(150 * pulse, 0, 0)
        end
    end)

    if stickyPart then
        local light = Instance.new("PointLight")
        light.Name = "AntiKickLight"
        light.Color = Color3.fromRGB(255, 20, 20)
        light.Range = 12
        light.Brightness = 4
