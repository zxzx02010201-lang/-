                    task.wait(600)
                end
            end)
        else
            if antiAfkConn then antiAfkConn:Disconnect(); antiAfkConn = nil end
            if antiAfkThread then task.cancel(antiAfkThread); antiAfkThread = nil end
        end
    end
})

