function DefenseModule.ClearToyByName(toyName)
    local inv = DefenseModule.GetToysFolder()
    local menuToys = ReplicatedStorage:FindFirstChild("MenuToys")
    local destroyRemote = menuToys and menuToys:FindFirstChild("DestroyToy")
    if inv and destroyRemote then
        for _, v in pairs(inv:GetChildren()) do
            if v.Name == toyName or v.Name == "AntiKick" or v.Name == "Noclipped" then
                pcall(function() destroyRemote:FireServer(v) end)
