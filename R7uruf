        Name = "🛡️ 刪除目標防踢 (SprayCanWD CFrame 精準定位擺頭)", Default = false,
        Callback = function(on) toggleSprayCanAntiKick(on) end
    })

    -- ==========================================
    -- 6. 伺服器卡頓 (Lag 伺服器) 與防 Lag 清除區塊
    -- ==========================================
    KickTab:AddSection({Name = "--- [ 伺服器壓力與防 Lag 控制 ] ---"})

    local serverLagEnabled = false
    local serverLagThread = nil
    local antiLagCleanupThread = nil
    local antiLagCleanupEnabled = false
    local lagAmount = 20

    -- 清理 GrabLine 的獨立輔助函數
    local function purgeAllGrabLines()
        pcall(function()
            local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
            local destroyRemote = GE and GE:FindFirstChild("DestroyGrabLine")
            if destroyRemote then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                        destroyRemote:FireServer(plr.Character.HumanoidRootPart)
                    end
                end
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    destroyRemote:FireServer(LocalPlayer.Character.HumanoidRootPart)
                end
            end
        end)
    end

    KickTab:AddSlider({
        Name = "<font color='#8B0000'>🔥 Lag 強度 (封包數量)</font>", 
        Min = 1, 
        Max = 100000, 
        Default = 20, 
        Increment = 50, 
        ValueName = "個封包/次", 
        Callback = function(v) 
            lagAmount = v 
        end
    })

    KickTab:AddToggle({
        Name = "<font color='#8B0000'><b>🔥 Lag 伺服器 (伺服器負載攻擊)</b></font>", 
        Default = false,
        Callback = function(state)
            serverLagEnabled = state
            if serverLagThread then 
                task.cancel(serverLagThread) 
                serverLagThread = nil 
            end
            
            if state then
                serverLagThread = task.spawn(function()
                    while serverLagEnabled do
                        local GrabEventsRef = ReplicatedStorage:FindFirstChild("GrabEvents")
                        local CreateGrabLineRef = GrabEventsRef and GrabEventsRef:FindFirstChild("CreateGrabLine")

                        if CreateGrabLineRef then
                            local SpawnLocation = Workspace:FindFirstChild("SpawnLocation") 
                                or Workspace:FindFirstChild("Spawn") 
                                or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))

                            if SpawnLocation then
                                for _ = 1, lagAmount do
                                    if not serverLagEnabled then break end
                                    local v55 = math.random(-1000000000, 1000000000)
                                    local v56 = math.random(-1000000000, 1000000000)

                                    pcall(function()
                                        CreateGrabLineRef:FireServer(SpawnLocation, CFrame.new(v55, 0, v56))
                                    end)
                                end
                            end
                        end
                        task.wait(0.02)
                    end
                end)
            else
                -- 🚨 關閉 Lag 瞬間立即發送刪除命令清除殘留
                purgeAllGrabLines()
            end
        end
    })

    -- 🛡️ 獨立線路：防 Lag 刪除（對抗外部外掛防卡頓）
    KickTab:AddToggle({
        Name = "🛡️ 防 Lag 刪除 (開闢獨立線路清理 GrabLine)", 
        Default = false,
        Callback = function(state)
            antiLagCleanupEnabled = state
            if antiLagCleanupThread then
                task.cancel(antiLagCleanupThread)
                antiLagCleanupThread = nil
            end

            if state then
                antiLagCleanupThread = task.spawn(function()
                    while antiLagCleanupEnabled do
                        -- 當伺服器 Lag 被關閉時，持續進行獨立監控與發送清除封包
                        if not serverLagEnabled then
                            purgeAllGrabLines()
                        end
                        task.wait(0.1)
                    end
                end)
            else
                purgeAllGrabLines()
            end
        end
    })

    KickTab:AddSection({Name = "--- [ 各模式獨立開關控制 ] ---"})
