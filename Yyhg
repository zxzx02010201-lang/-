ToggleObjects["AntiWater"] = aa57_defense:AddToggle({
    Name = "Anti Water (防落水/水面踩踏)",
    Default = false,
    Callback = function(Value)
        Config.AntiWater = Value
        local map = Workspace:FindFirstChild("Map")
        local alwaysHere = map and map:FindFirstChild("AlwaysHereTweenedObjects")
        local ocean = alwaysHere and alwaysHere:FindFirstChild("Ocean")
        local oceanObject = ocean and ocean:FindFirstChild("Object")
        local oceanModel = oceanObject and oceanObject:FindFirstChild("ObjectModel")
        
        if oceanModel then
            for _, part in pairs(oceanModel:GetChildren()) do
                if part:IsA("BasePart") and part.Name == "Ocean" then
                    part.CanCollide = Value
                end
            end
        end
    end
})

